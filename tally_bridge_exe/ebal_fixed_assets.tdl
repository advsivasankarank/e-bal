;; ============================================================
;; eBAL Smart Bridge -- Fixed Asset TDL Add-On
;; ============================================================
;;
;; Purpose: exposes two report IDs the bridge can call directly, so
;; Tally does the Fixed Asset filtering itself instead of the bridge
;; fetching every voucher type for the full year and filtering
;; client-side. Both collections are re-usable across financial years
;; and companies -- nothing here is hardcoded to one company.
;;
;; INSTALL:
;;   TallyPrime > F1 (Help) > TDL & Add-On > F4 (Manage Local TDLs)
;;   > set "Load selected TDL files on startup" to Yes
;;   > add this file's full path under "List of TDL files"
;;   > Save (Ctrl+A), then restart Tally.
;;
;; VERIFY IT LOADED CORRECTLY:
;;   Re-open F1 > TDL & Add-On -- if there's a syntax error anywhere
;;   below, Tally will show it right there on that screen, naming the
;;   exact problem, instead of the bridge having to infer it indirectly
;;   from a failed/empty HTTP response. That is the whole point of
;;   installing this as a real file rather than embedding it in every
;;   request: fast, direct compiler feedback while testing.
;;
;; REVISION HISTORY:
;;   v1 used $$FilterAny:AllLedgerEntries:... on the Voucher collection
;;   to ask "does any entry match" as a single yes/no formula -- tested
;;   live and rejected outright ("Cannot understand. Bad formula!"), so
;;   $$FilterAny is not valid TDL used that way. v2 (below) avoids that
;;   construct entirely: instead of filtering VOUCHERS by a property of
;;   their nested entries, it WALKs INTO the entries directly and
;;   filters AT the entry level (a single, non-nested condition per
;;   entry -- $$StringFind:$LedgerName:... alone, no aggregate/any-match
;;   function needed), which is the standard way Tally's own built-in
;;   reports (Sales Register, Purchase Register, etc.) are built in
;;   TDL. This produces one row per MATCHING ENTRY rather than one row
;;   per voucher (a voucher with 2 Fixed Asset entries appears twice) --
;;   the bridge already deduplicates by voucher GUID when parsing, so
;;   this doesn't need to be handled here.
;;
;; STILL NEEDS LIVE VERIFICATION:
;;   The ".." parent-navigation prefix on FAVoucherEntries' Fetch list
;;   (used to pull voucher-level fields like Date/VoucherTypeName from
;;   the entry's enclosing Voucher, since Walk changes the collection's
;;   "current object" to each LedgerEntry) is the one part of this
;;   version untested against live Tally. If Tally rejects a field with
;;   "..", it needs a different navigation syntax -- report the exact
;;   error the same way as last time.
;;
;; ------------------------------------------------------------------
;; FAGroupLedgers -- every ledger under "Fixed Assets" or any of its
;; nested sub-groups (e.g. "Fixed Assets > Vehicles"). <CHILDOF> +
;; <BELONGSTO>Yes</BELONGSTO> (here: "Child Of" + "Belongs To : Yes")
;; is Tally's standard, well-documented attribute pair for exactly
;; this "this group or any descendant" membership test. Unchanged from
;; v1 -- this part was never in question.
;; ------------------------------------------------------------------
[Collection: FAGroupLedgers]
    Type            : Ledger
    Child Of        : "Fixed Assets"
    Belongs To      : Yes
    Fetch           : Name

;; ------------------------------------------------------------------
;; FAVoucherEntries -- one row per ledger entry (within whatever
;; SVFROMDATE/SVTODATE the caller sets) whose ledger name appears in
;; ##SVFALEDGERLIST, a pipe-separated list the bridge supplies at
;; request time (built from FAGroupLedgers above, or from e-BAL's own
;; ReconHub classification -- either way, supplied dynamically, not
;; hardcoded here). Each row carries both the entry's own fields
;; (LedgerName, Amount, Parent group) and its enclosing voucher's
;; fields (via ".."), since Walk makes each LedgerEntry the collection's
;; current object, not the Voucher.
;; ------------------------------------------------------------------
[Collection: FAVoucherEntries]
    Type            : Voucher
    Child Of        : $$VchVouchers
    Walk            : AllLedgerEntries
    Fetch           : ..Guid, ..VoucherTypeName, ..VoucherNumber, ..Date, ..EffectiveDate, ..Narration, ..PartyLedgerName, ..IsOptional, ..IsCancelled, ..AlterDate, ..EnteredDate, LedgerName, Amount, Parent
    Filter          : FAEntryMatches

[System: Formulae]
    FAEntryMatches : $$StringFind:$LedgerName:##SVFALedgerList

;; ------------------------------------------------------------------
;; SVFALedgerList -- a static variable (not a hardcoded value) that
;; the bridge sets per-request via STATICVARIABLES, e.g.:
;;   <SVFALEDGERLIST>Plant &amp; Machinery|Vehicles - Ambulance|...</SVFALEDGERLIST>
;; Declared here with an empty default so the report doesn't error out
;; if called without it (matches nothing, rather than crashing).
;; ------------------------------------------------------------------
[System: Variable]
    SVFALedgerList : String : ""
