;; ============================================================
;; eBAL Smart Bridge -- Fixed Asset TDL Add-On (v3)
;; ============================================================
;;
;; v3 uses $$IsLedOfGrp, TallyPrime's own built-in ledger-group-
;; membership check -- confirmed working live against this company's
;; real data (a populated "Fixed Assets Voucher Listing" report,
;; correctly matching ledgers across several different Fixed Asset
;; sub-groups from a single "Fixed Assets" string, confirming it
;; handles nested sub-groups natively). This replaces both earlier
;; attempts:
;;   v1: $$FilterAny:AllLedgerEntries:... -- rejected outright by
;;       Tally ("Cannot understand. Bad formula!"). Not valid TDL.
;;   v2: Walk + ".." parent-navigation -- untested guess, superseded
;;       before it was tried, now that a confirmed-working function
;;       exists.
;;
;; IsFixedAssetsVoucher checks the first TWO ledger entries (index 1
;; and 2), not just entry 1 as originally tested -- a Fixed Asset
;; purchase/disposal voucher typically has exactly two legs (Dr/Cr),
;; and the Fixed Asset ledger can legitimately be on either side
;; depending on how it was entered; checking only entry 1 would
;; silently miss vouchers where it's entry 2. Vouchers with more than
;; two ledger entries (split allocations across several ledgers)
;; aren't covered by this and would need additional index checks if
;; that turns out to matter for real data from this company.
;;
;; INSTALL:
;;   TallyPrime > F1 (Help) > TDL & Add-On > F4 (Manage Local TDLs)
;;   > set "Load selected TDL files on startup" to Yes
;;   > add this file's full path under "List of TDL files"
;;   > Save (Ctrl+A), then restart Tally.
;;
;; The on-screen "Fixed Assets Vouchers" menu item (Gateway of Tally)
;; is kept from the version already tested live -- lets the CA browse
;; this same list directly inside Tally, independent of the bridge/
;; e-BAL sync, as a standing cross-check.

[#Menu: Gateway of Tally]
Add: Item : Before : @@locQuit : Fixed Assets Vouchers : Display : FixedAssetsVoucherReport

[Report: FixedAssetsVoucherReport]
Title : "Fixed Assets Voucher Listing"
Form  : FixedAssetsVoucherForm

[Form: FixedAssetsVoucherForm]
Part : FixedAssetsVoucherPart

[Part: FixedAssetsVoucherPart]
Lines : FixedAssetsVoucherLine
Repeat : FixedAssetsVoucherLine : FixedAssetsVoucherColl
Scroll : Vertical

[Line: FixedAssetsVoucherLine]
Fields : FAVDate, FAVLedger, FAVAmount, FAVVoucherType

[Field: FAVDate]
Use     : Date Field
Set as  : $Date

[Field: FAVLedger]
Use     : Name Field
Set as  : $LedgerName

[Field: FAVAmount]
Use     : Amount Field
Set as  : $Amount

[Field: FAVVoucherType]
Use     : Name Field
Set as  : $VoucherTypeName

;; ------------------------------------------------------------------
;; FixedAssetsVoucherColl -- the on-screen report's data source.
;; ------------------------------------------------------------------
[Collection: FixedAssetsVoucherColl]
Type    : Voucher
Filters : IsFixedAssetsVoucher

[System: Formula]
IsFixedAssetsVoucher : $$IsLedOfGrp:$LedgerEntries[1].LedgerName:"Fixed Assets" OR $$IsLedOfGrp:$LedgerEntries[2].LedgerName:"Fixed Assets"

;; ------------------------------------------------------------------
;; FAVouchers -- the export-oriented collection the bridge calls via
;; HTTP (TALLYREQUEST=Export, TYPE=Collection, ID=FAVouchers). Same
;; IsFixedAssetsVoucher filter as the on-screen report above, but
;; fetches the full field set the bridge's parser expects (GUID,
;; VoucherTypeName, VoucherNumber, Date, EffectiveDate, Narration,
;; PartyLedgerName, IsOptional, IsCancelled, AlterDate, EnteredDate,
;; and the nested LedgerEntries list itself) instead of the single
;; flattened row the on-screen display uses.
;; ------------------------------------------------------------------
[Collection: FAVouchers]
Type     : Voucher
Child Of : $$VchVouchers
Fetch    : Guid, VoucherTypeName, VoucherNumber, Date, EffectiveDate, Narration, PartyLedgerName, IsOptional, IsCancelled, AlterDate, EnteredDate, LedgerEntries
Filters  : IsFixedAssetsVoucher
