# Deny direct web access to this directory. Nothing here should ever be
# requested directly over HTTP -- application code reaches these files via
# PHP require/include, not URL routing.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
